// Blessed Ave Cafe — Prisma Schema
// Database: PostgreSQL

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders             Order[]
  shifts             Shift[]
  clockEvents        ClockEvent[]
  refreshTokens      RefreshToken[]
  tillSessionsOpened TillSession[]  @relation("TillOpenedBy")
  tillSessionsClosed TillSession[]  @relation("TillClosedBy")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── Menu ─────────────────────────────────────────────────────────────────────

model MenuCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  price       Int // in centavos (PHP)
  imageUrl    String?
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       MenuCategory    @relation(fields: [categoryId], references: [id])
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  recipeItems    RecipeItem[]

  @@map("menu_items")
}

model ModifierGroup {
  id          String  @id @default(cuid())
  menuItemId  String
  name        String // e.g. "Size", "Milk Type", "Add-ons"
  required    Boolean @default(false)
  multiSelect Boolean @default(false)
  sortOrder   Int     @default(0)

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  ModifierOption[]

  @@map("modifier_groups")
}

model ModifierOption {
  id              String @id @default(cuid())
  groupId         String
  name            String
  priceAdjustment Int    @default(0) // centavos, can be 0 or negative

  group           ModifierGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  selectedOptions SelectedOption[]

  @@map("modifier_options")
}

// ─── Tables ───────────────────────────────────────────────────────────────────

model CafeTable {
  id      String  @id @default(cuid())
  name    String // e.g. "Table 1"
  qrToken String  @unique @default(cuid())
  active  Boolean @default(true)

  orders Order[]

  @@map("cafe_tables")
}

// ─── Orders ───────────────────────────────────────────────────────────────────

enum OrderSource {
  ONLINE
  QR_TABLE
  POS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COLLECTED
  CANCELLED
}

enum DiscountType {
  NONE
  SENIOR_PWD // RA 9994 / RA 10754 — 20% discount + VAT exemption
  CUSTOM // manager-applied manual discount
}

model Order {
  id               String       @id @default(cuid())
  source           OrderSource
  status           OrderStatus  @default(PENDING)
  tableId          String?
  staffId          String? // for POS orders
  customerName     String?
  customerPhone    String?
  customerEmail    String?
  notes            String?
  subtotal         Int // centavos, before discount
  total            Int // centavos (subtotal after any discounts) — the amount actually charged
  discountType     DiscountType @default(NONE)
  discountAmount   Int          @default(0) // centavos
  discountIdNumber String? // OSCA / PWD ID number when discountType = SENIOR_PWD
  vatAmount        Int          @default(0) // centavos, VAT portion of total (0 when VAT-exempt via SENIOR_PWD)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  startedAt        DateTime? // when kitchen marked PREPARING — queue-time training metric
  readyAt          DateTime? // when kitchen marked READY — prep-time training metric
  collectedAt      DateTime? // when marked COLLECTED — total service-time training metric

  table   CafeTable?  @relation(fields: [tableId], references: [id])
  staff   User?       @relation(fields: [staffId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  menuItemId   String
  menuItemName String // snapshot at time of order
  quantity     Int
  unitPrice    Int // centavos, snapshot at time of order
  subtotal     Int // centavos
  notes        String?

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem        MenuItem         @relation(fields: [menuItemId], references: [id])
  selectedOptions SelectedOption[]

  @@map("order_items")
}

model SelectedOption {
  id               String @id @default(cuid())
  orderItemId      String
  modifierOptionId String
  name             String // snapshot
  priceAdjustment  Int // snapshot

  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id])

  @@map("selected_options")
}

// ─── Payments ─────────────────────────────────────────────────────────────────

enum PaymentMethod {
  GCASH
  MAYA
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id                      String        @id @default(cuid())
  orderId                 String        @unique
  method                  PaymentMethod
  status                  PaymentStatus @default(PENDING)
  amount                  Int // centavos
  paymongoPaymentIntentId String?
  paymongoSourceId        String?
  receiptUrl              String?
  paidAt                  DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

enum InventoryUnit {
  KG
  G
  L
  ML
  PCS
  PACK
  BOTTLE
}

model InventoryItem {
  id                String        @id @default(cuid())
  name              String
  unit              InventoryUnit
  currentStock      Float         @default(0)
  lowStockThreshold Float         @default(0)
  cost              Int           @default(0) // centavos per unit
  supplierId        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  inventoryLogs      InventoryLog[]
  recipeItems        RecipeItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("inventory_items")
}

enum InventoryLogReason {
  SALE
  PURCHASE
  WASTE
  ADJUSTMENT
  OPENING_STOCK
}

model InventoryLog {
  id              String             @id @default(cuid())
  inventoryItemId String
  reason          InventoryLogReason
  quantityChange  Float // negative for consumption, positive for purchase
  stockAfter      Float
  notes           String?
  createdAt       DateTime           @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("inventory_logs")
}

// Recipe mapping — how much of each ingredient a menu item uses
model RecipeItem {
  id              String @id @default(cuid())
  menuItemId      String
  inventoryItemId String
  quantity        Float // amount consumed per 1 of this menu item

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([menuItemId, inventoryItemId])
  @@map("recipe_items")
}

// ─── Suppliers ────────────────────────────────────────────────────────────────

model Supplier {
  id          String  @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  notes       String?
  active      Boolean @default(true)

  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id         String    @id @default(cuid())
  supplierId String
  total      Int // centavos
  notes      String?
  createdAt  DateTime  @default(now())
  receivedAt DateTime?

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  inventoryItemId String
  quantity        Float
  unitCost        Int // centavos

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("purchase_order_items")
}

// ─── Staff & Scheduling ───────────────────────────────────────────────────────

model Shift {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("shifts")
}

model ClockEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String // "CLOCK_IN" | "CLOCK_OUT"
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("clock_events")
}

// ─── Till / Cash Drawer ───────────────────────────────────────────────────────

enum TillSessionStatus {
  OPEN
  CLOSED
}

model TillSession {
  id           String            @id @default(cuid())
  status       TillSessionStatus @default(OPEN)
  openedById   String
  openedAt     DateTime          @default(now())
  openingFloat Int // centavos — starting cash in drawer
  closedById   String?
  closedAt     DateTime?
  expectedCash Int? // centavos — openingFloat + cash sales - cash refunds, computed at close
  actualCash   Int? // centavos — physically counted at close
  variance     Int? // centavos — actualCash - expectedCash
  notes        String?

  openedBy User  @relation("TillOpenedBy", fields: [openedById], references: [id])
  closedBy User? @relation("TillClosedBy", fields: [closedById], references: [id])

  @@map("till_sessions")
}

// ─── Operating Costs ──────────────────────────────────────────────────────────

enum CostCategory {
  RENT
  UTILITIES
  WAGES
  PACKAGING
  MARKETING
  EQUIPMENT
  MAINTENANCE
  OTHER
}

enum CostFrequency {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// Key-value store for business-level toggles (e.g. "vat_enabled").
// Values are strings; booleans stored as "true"/"false".
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model OperatingCost {
  id         String        @id @default(cuid())
  name       String // e.g. "Monthly Rent", "Electricity Bill"
  category   CostCategory
  frequency  CostFrequency
  amount     Int // centavos
  date       DateTime      @db.Date // the date this cost was incurred
  vendor     String? // supplier/payee name, e.g. "Meralco", "ABC Repairs Co."
  notes      String?
  // Populated when this expense originated from a scanned receipt rather than
  // manual entry. NULL for manually-entered costs.
  // TODO(ai-receipt-reader): once an AI/OCR receipt-scanning flow exists,
  // it should be able to POST here (via /api/operating-costs) for any
  // scanned receipt that isn't a food/inventory purchase — e.g. utility
  // bills, repair invoices — using this field to store the source receipt's
  // image URL/id for audit purposes. No such scanner exists yet in this repo.
  receiptRef String?
  createdAt  DateTime      @default(now())

  @@map("operating_costs")
}
